[gd_scene format=3]

[ext_resource type="Script" path="res://scripts/ui/title_screen.gd" id="1_title"]
[ext_resource type="Texture2D" path="res://assets/tiles/cursed_ground.png" id="2_ground"]
[ext_resource type="Texture2D" path="res://assets/objects/lantern_post.png" id="3_lantern"]
[ext_resource type="StyleBox" path="res://data/ui/menu_panel.tres" id="4_style"]

[node name="TitleScreen" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_title")

[node name="Ground" type="TextureRect" parent="."]
modulate = Color(0.6, 0.58, 0.7, 1)
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
texture = ExtResource("2_ground")
stretch_mode = 1

[node name="Center" type="CenterContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0

[node name="Box" type="VBoxContainer" parent="Center"]
custom_minimum_size = Vector2(240, 0)
layout_mode = 2
theme_override_constants/separation = 6

[node name="Lantern" type="TextureRect" parent="Center/Box"]
layout_mode = 2
texture = ExtResource("3_lantern")
stretch_mode = 3

[node name="Title" type="Label" parent="Center/Box"]
layout_mode = 2
theme_override_font_sizes/font_size = 30
text = "The Cursed Island"
horizontal_alignment = 1

[node name="Tagline" type="Label" parent="Center/Box"]
layout_mode = 2
theme_override_font_sizes/font_size = 12
text = "Every field you grow pushes the darkness back."
horizontal_alignment = 1

[node name="Continue" type="Button" parent="Center/Box"]
custom_minimum_size = Vector2(0, 34)
layout_mode = 2
text = "Continue"

[node name="NewGame" type="Button" parent="Center/Box"]
custom_minimum_size = Vector2(0, 34)
layout_mode = 2
text = "New Game"

[node name="Quit" type="Button" parent="Center/Box"]
custom_minimum_size = Vector2(0, 34)
layout_mode = 2
text = "Quit"

[node name="SaveNote" type="Label" parent="Center/Box"]
layout_mode = 2
theme_override_font_sizes/font_size = 12
text = "Your farm saves when you sleep."
horizontal_alignment = 1

[node name="Confirm" type="PanelContainer" parent="."]
visible = false
custom_minimum_size = Vector2(320, 0)
layout_mode = 1
anchors_preset = 8
anchor_left = 0.5
anchor_top = 0.5
anchor_right = 0.5
anchor_bottom = 0.5
grow_horizontal = 2
grow_vertical = 2
theme_override_styles/panel = ExtResource("4_style")

[node name="Margin" type="MarginContainer" parent="Confirm"]
layout_mode = 2
theme_override_constants/margin_left = 12
theme_override_constants/margin_top = 10
theme_override_constants/margin_right = 12
theme_override_constants/margin_bottom = 10

[node name="Box" type="VBoxContainer" parent="Confirm/Margin"]
layout_mode = 2
theme_override_constants/separation = 10

[node name="Message" type="Label" parent="Confirm/Margin/Box"]
custom_minimum_size = Vector2(296, 0)
layout_mode = 2
horizontal_alignment = 1
autowrap_mode = 3

[node name="Buttons" type="HBoxContainer" parent="Confirm/Margin/Box"]
layout_mode = 2
alignment = 1
theme_override_constants/separation = 12

[node name="Yes" type="Button" parent="Confirm/Margin/Box/Buttons"]
custom_minimum_size = Vector2(0, 36)
layout_mode = 2
text = "Yes, start over"

[node name="No" type="Button" parent="Confirm/Margin/Box/Buttons"]
custom_minimum_size = Vector2(0, 36)
layout_mode = 2
text = "No, keep my farm"
